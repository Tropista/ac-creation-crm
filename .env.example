# ── URL publique (partage devis clients) ──
# Prioritaire sur Paramètres → URL publique du CRM si les deux sont définis.
# Vercel définit automatiquement VITE_VERCEL_URL au build si non renseigné ici.
VITE_PUBLIC_APP_URL=https://ac-creation-crm.vercel.app

# ── Supabase (obligatoire pour auth, sync cloud et rapprochement bancaire) ──
# Dashboard Supabase → Settings → API
# IMPORTANT pour Electron : ces variables sont intégrées au build Vite.
# Copiez ce fichier en .env AVANT `npm run build` ou `npm run dist`.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# ── API banque (frontend → backend/server.js) ──
# Navigateur / npm run dev : le backend se lance avec `npm run bank`.
# Electron (npm run electron / installeur) : démarrage automatique du backend.
VITE_BANK_API_URL=http://127.0.0.1:3001

# Optionnel : si EMAIL_API_TOKEN est defini cote backend, renseigner la meme valeur
# en VITE_EMAIL_API_TOKEN pour autoriser les appels locaux /send-email.
EMAIL_API_TOKEN=changez-moi-en-une-valeur-longue
VITE_EMAIL_API_TOKEN=changez-moi-en-une-valeur-longue

# Optionnel : identifiants SMTP cote serveur. Si renseignes, le frontend n'a plus
# besoin d'envoyer smtpEmail/smtpAppPassword dans chaque requete /send-email.
SMTP_EMAIL=ac.creation.officiel@gmail.com
SMTP_APP_PASSWORD=mot_de_passe_application_google
SMTP_FROM_NAME=AC Creation

# Optionnel : origines autorisees en plus de localhost/127.0.0.1 pour l'API locale.
BANK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Tink (optionnel — backend/server.js) ──
# Console : https://console.tink.com
# Redirect URI à configurer chez Tink :
#   http://127.0.0.1:3001/api/bank/callback
# Sans TINK_CLIENT_ID : mode saisie manuelle uniquement dans Banque.
TINK_CLIENT_ID=votre_client_id_tink
TINK_CLIENT_SECRET=votre_client_secret_tink
TINK_REDIRECT_URI=http://127.0.0.1:3001/api/bank/callback
TINK_MARKET=LU
TINK_LOCALE=fr_FR

# Port / hôte du serveur Express banque (défaut : 127.0.0.1:3001)
PORT=3001
BANK_HOST=127.0.0.1

# ── API privée d'intégration site → CRM ──
# Clé service_role exclusivement côté serveur. Ne jamais utiliser un préfixe VITE_.
CRM_SUPABASE_URL=https://votre-projet.supabase.co
CRM_SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role
CRM_HMAC_KEY_ID=site
CRM_HMAC_SECRET=generez_au_moins_32_octets_aleatoires
CRM_HMAC_TTL_MS=300000
APP_BUILD_ID=local
APP_COMMIT_SHA=
APP_BUILD_DATE=

# ── Build Electron (atelier) ──
# Les variables VITE_* sont intégrées au build Vite (npm run build / dist).
# Elles ne sont PAS relues au lancement de l’exe — configurez .env AVANT le build.
#
# 1. Copier ce fichier : cp .env.example .env  (Windows : copy .env.example .env)
# 2. Renseigner VITE_SUPABASE_* (obligatoire pour sync cloud)
# 3. npm run build && npm run dist   (ou npm run dist:win)
# 4. Installer depuis release/AC Creation CRM Setup *.exe
# 5. Tink (optionnel) : copier TINK_* dans .env à la racine du projet AVANT dist,
#    ou placer un fichier .env dans %APPDATA%/AC Creation CRM/ après installation
#    (Electron démarre automatiquement backend/server.js — pas de npm run bank)
#
# ── Mises à jour automatiques (installeur Windows uniquement) ──
# - Incrémenter "version" dans package.json, puis npm run dist:win
# - Créer une GitHub Release (tag vX.Y.Z) sur github.com/Tropista/ac-creation-crm
# - Uploader release/latest.yml + release/AC Creation CRM Setup *.exe
# - Les postes installés vérifient GitHub au démarrage et proposent la mise à jour
#   dans Paramètres (pas actif avec npm run electron en dev)
# - Publication auto (optionnel) : GH_TOKEN=... npm run dist:win -- --publish always
#
# Configurateur public → devis :
# - Route publique : /configurateur-tshirt (sans login CRM)
# - « Créer un devis » enregistre un brouillon localStorage (même navigateur)
# - Ouvrir le CRM → /devis pour finaliser le devis
