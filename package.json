{
  "name": "ac-creation-crm",
  "private": true,
  "version": "1.0.5",
  "productName": "AC Creation CRM",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,backend -c cyan,yellow \"vite\" \"node backend/server.js\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:release": "node -e \"require('fs').rmSync('release/win-unpacked',{recursive:true,force:true})\"",
    "prebuild": "npm run clean:dist",
    "build": "vite build",
    "predist": "npm run clean:release",
    "predist:win": "npm run clean:release",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "electron": "electron .",
    "bank": "node backend/server.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "bank:win": "powershell -NoProfile -Command \"foreach ($line in (netstat -ano | findstr ':3001' | findstr LISTENING)) { $p = ($line -split '\\s+')[-1]; if ($p -and $p -ne '0') { taskkill /PID $p /F 2>$null } }; node backend/server.js\"",
    "bank:restart": "powershell -NoProfile -Command \"foreach ($line in (netstat -ano | findstr ':3001' | findstr LISTENING)) { $p = ($line -split '\\s+')[-1]; if ($p -and $p -ne '0') { taskkill /PID $p /F 2>$null } }; node backend/server.js\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "nodemailer": "^8.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.15.4",
    "three": "^0.184.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.accreation.crm",
    "productName": "AC Creation CRM",
    "artifactName": "AC-Creation-CRM-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "backend/**/*",
      "electron.cjs",
      "electron-bank.cjs",
      "electron-updater.cjs",
      "electron-preload.cjs",
      "package.json",
      "public/icon.ico"
    ],
    "asarUnpack": [
      "dist/models/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AC Creation CRM"
    },
    "publish": {
      "provider": "github",
      "owner": "Tropista",
      "repo": "ac-creation-crm"
    }
  }
}
